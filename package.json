{
  "name": "daily-briefing",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Email a daily briefing assembled from configured intelligence topics.",
  "scripts": {
    "briefing": "node src/index.js",
    "dashboard": "node scripts/dashboard-server.mjs",
    "example": "node scripts/render-example.mjs",
    "generate": "node scripts/generate-email.mjs",
    "preview": "node src/preview.js",
    "send:now": "node scripts/send-now.mjs",
    "check": "node scripts/check.mjs && npm test",
    "test": "node --test",
    "validate": "node scripts/validate-config.mjs",
    "briefing:backfill": "node scripts/backfill.mjs"
  },
  "dependencies": {
    "nodemailer": "^9.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
